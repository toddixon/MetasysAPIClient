{
  "name": "metasys-apiclient",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/generate-icon-manifest.mjs",
    "start": "ng serve --configuration=production --port=4200",
    "start:dev": "ng serve --configuration development --proxy-config proxy.conf.json --port=4200",
    "start:mock-api": "ng serve --configuration=mock-api --proxy-config proxy.mock-api.conf.json --port=4200",
    "prebuild": "node scripts/generate-icon-manifest.mjs",
    "build": "ng build",
    "build:mock-api": "ng build --configuration=mock-api",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "preproxy": "node scripts/generate-icon-manifest.mjs",
    "dev:all": "concurrently -n metasys-apiclient,metasys-mock-api -c blue,green \"npm run start:mock-api\" \"npm run mock-api:dev\"",
    "mock-api:build": "npm --prefix mock-api run build",
    "mock-api:dev": "npm --prefix mock-api run dev",
    "mock-api:refresh": "npm --prefix mock-api run refresh --",
    "mock-api:start": "npm --prefix mock-api run start",
    "mock-api:seed": "npm --prefix mock-api run seed",
    "getVersion": "ng v",
    "gen:api": "openapi-generator-cli generate -i ./references/openapi_v6_14-1.json -g typescript-angular -o ./src/app/api --additional-properties=ngVersion=17,providedIn=root,rxjsVersion=7"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.0.8",
    "@angular/cdk": "^21.0.6",
    "@angular/common": "^21.0.8",
    "@angular/compiler": "^21.0.8",
    "@angular/core": "^21.0.8",
    "@angular/forms": "^21.0.8",
    "@angular/material": "^21.0.6",
    "@angular/platform-browser": "^21.0.8",
    "@angular/platform-browser-dynamic": "^21.0.8",
    "@angular/router": "^21.0.8",
    "axios": "^1.12.2",
    "material-icons": "^1.13.14",
    "ngx-skeleton-loader": "^11.3.0",
    "ngx-sse-client": "^20.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.0.5",
    "@angular/cli": "^21.0.5",
    "@angular/compiler-cli": "^21.0.8",
    "@types/jasmine": "~5.1.0",
    "baseline-browser-mapping": "^2.10.18",
    "concurrently": "^9.2.1",
    "jasmine-core": "~5.1.0",
    "json-schema-to-ts": "^3.1.1",
    "json-schema-to-typescript": "^15.0.4",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.3"
  }
}