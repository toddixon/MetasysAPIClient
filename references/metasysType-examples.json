### Example of metasysType=ListOf

{
  title: "Alarm Values",
  category: "attributeCategoryEnumSet.alarmValuesCategory",
  type: "array",
  metasysType: "listof",
  items: {
    type: "object",
    metasysType: "struct",
    properties: {
      state: {
        category: "attributeCategoryEnumSet.parentalInputCategory",
        enumSetSource: "attributeEnumSet.statesText",
        allOf: [
          {
            type: "string",
            metasysType: "enum",
          },
          {
            $ref: "https://desktop-vm/api/v6/schemas/enums/closeOpenEnumSet",
          },
        ],
        title: "State",
      },
      priority: {
        metasysType: "byte",
        type: "integer",
        minimum: 0,
        maximum: 255,
        title: "Priority",
      },
      almMsgTxt: {
        category: "attributeCategoryEnumSet.alarmValuesTextCategory",
        type: "string",
        metasysType: "string",
        maxLength: 16383,
        title: "Alarm Message Text",
      },
    },
  },
}

