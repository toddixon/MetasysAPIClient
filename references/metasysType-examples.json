### Exampte of metasysType=array (looks like the metasysType is array if the array entries are of primitive types, and a listOf if the array entries are of complex types)

{
  category: "attributeCategoryEnumSet.ipAddressCategory",
  type: "array",
  metasysType: "array",
  items: {
    metasysType: "byte",
    type: "integer",
    minimum: 0,
    maximum: 255,
  },
  maxItems: 4,
  minItems: 4,
  title: "IP Address",
}


### Example of metasysType=date

{
  title: "Date",
  readOnly: true,
  metasysType: "date",
  oneOf: [
    {
      type: "null",
    },
    {
      type: "object",
      metasysType: "date",
      properties: {
        year: {
          oneOf: [
            {
              type: "integer",
              metasysType: "ushort",
              minimum: 1900,
              maximum: 2154,
            },
            {
              type: "integer",
              metasysType: "byte",
              minimum: 0,
              maximum: 254,
            },
          ],
        },
        month: {
          oneOf: [
            {
              type: "integer",
              metasysType: "byte",
              minimum: 1,
              maximum: 12,
            },
            {
              allOf: [
                {
                  type: "string",
                  metasysType: "enum",
                  lastMember: "monthEnumSet.monthDec",
                },
                {
                  $ref: "https://desktop-vm/api/v6/schemas/enums/monthEnumSet",
                },
              ],
            },
          ],
        },
        dayOfMonth: {
          oneOf: [
            {
              type: "integer",
              metasysType: "byte",
              minimum: 1,
              maximum: 31,
            },
            {
              allOf: [
                {
                  type: "string",
                  metasysType: "enum",
                  lastMember: "bacnetDayOfMonthEnumSet.bdom31",
                },
                {
                  $ref: "https://desktop-vm/api/v6/schemas/enums/bacnetDayOfMonthEnumSet",
                },
              ],
            },
          ],
        },
        dayOfWeek: {
          oneOf: [
            {
              type: "integer",
              metasysType: "byte",
              minimum: 1,
              maximum: 7,
            },
            {
              type: "integer",
              metasysType: "byte",
              const: 255,
            },
            {
              type: "string",
              metasysType: "string",
              const: "any",
            },
            {
              $ref: "https://desktop-vm/api/v6/schemas/enums/dayOfWeekEnumSet",
            },
          ],
        },
      },
      required: [
        "year",
        "month",
        "dayOfMonth",
      ],
      display: [
        "year",
        "month",
        "dayOfMonth",
      ],
      additionalProperties: false,
    },
  ],
}


