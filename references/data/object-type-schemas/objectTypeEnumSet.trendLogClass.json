{
  "schema": {
    "type": "object",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "language": "en-US",
    "title": "JCI Trend Log",
    "version": "1.0",
    "$id": "https://desktop-vm/api/v6/schemas/objectTypes/trendLogClass",
    "properties": {
      "name": {
        "title": "Name",
        "category": "attributeCategoryEnumSet.nameCategory",
        "type": "string",
        "metasysType": "string",
        "maxLength": 400,
        "default": ""
      },
      "description": {
        "title": "Description",
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "metasysType": "string",
        "maxLength": 64
      },
      "bacnetObjectType": {
        "title": "Object Type",
        "readOnly": true,
        "allOf": [
          {
            "type": "string",
            "metasysType": "enum"
          },
          {
            "$ref": "https://desktop-vm/api/v6/schemas/enums/objectTypeEnumSet"
          }
        ],
        "default": "objectTypeEnumSet.bacTrendLogClass"
      },
      "enable": {
        "title": "Enable",
        "type": "boolean",
        "metasysType": "bool",
        "default": true
      },
      "startTime": {
        "title": "Start Time",
        "category": "attributeCategoryEnumSet.bacnetDateTimeCategory",
        "type": "object",
        "metasysType": "struct",
        "properties": {
          "date": {
            "metasysType": "date",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "metasysType": "date",
                "properties": {
                  "year": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "metasysType": "ushort",
                        "minimum": 1900,
                        "maximum": 2154
                      },
                      {
                        "type": "integer",
                        "metasysType": "byte",
                        "minimum": 0,
                        "maximum": 255
                      },
                      {
                        "type": "string",
                        "metasysType": "string",
                        "const": "any"
                      }
                    ]
                  },
                  "month": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "metasysType": "byte",
                        "minimum": 1,
                        "maximum": 12
                      },
                      {
                        "type": "integer",
                        "metasysType": "byte",
                        "const": 255
                      },
                      {
                        "type": "string",
                        "metasysType": "string",
                        "const": "any"
                      },
                      {
                        "$ref": "https://desktop-vm/api/v6/schemas/enums/monthEnumSet"
                      }
                    ]
                  },
                  "dayOfMonth": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "metasysType": "byte",
                        "minimum": 1,
                        "maximum": 31
                      },
                      {
                        "type": "integer",
                        "metasysType": "byte",
                        "const": 255
                      },
                      {
                        "type": "string",
                        "metasysType": "string",
                        "const": "any"
                      },
                      {
                        "$ref": "https://desktop-vm/api/v6/schemas/enums/bacnetDayOfMonthEnumSet"
                      }
                    ]
                  },
                  "dayOfWeek": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "metasysType": "byte",
                        "minimum": 1,
                        "maximum": 7
                      },
                      {
                        "type": "integer",
                        "metasysType": "byte",
                        "const": 255
                      },
                      {
                        "type": "string",
                        "metasysType": "string",
                        "const": "any"
                      },
                      {
                        "$ref": "https://desktop-vm/api/v6/schemas/enums/dayOfWeekEnumSet"
                      }
                    ]
                  }
                },
                "required": [
                  "year",
                  "month",
                  "dayOfMonth"
                ],
                "display": [
                  "year",
                  "month",
                  "dayOfMonth"
                ],
                "additionalProperties": false
              }
            ],
            "title": "Date"
          },
          "time": {
            "oneOf": [
              {
                "allOf": [
                  {
                    "$ref": "#metasys-time"
                  },
                  {
                    "display": [
                      "hour",
                      "minute",
                      "second"
                    ]
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "metasysType": "time",
            "title": "Time"
          }
        },
        "default": {
          "date": null,
          "time": null
        }
      },
      "stopTime": {
        "title": "Stop Time",
        "category": "attributeCategoryEnumSet.bacnetDateTimeCategory",
        "type": "object",
        "metasysType": "struct",
        "properties": {
          "date": {
            "metasysType": "date",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "metasysType": "date",
                "properties": {
                  "year": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "metasysType": "ushort",
                        "minimum": 1900,
                        "maximum": 2154
                      },
                      {
                        "type": "integer",
                        "metasysType": "byte",
                        "minimum": 0,
                        "maximum": 255
                      },
                      {
                        "type": "string",
                        "metasysType": "string",
                        "const": "any"
                      }
                    ]
                  },
                  "month": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "metasysType": "byte",
                        "minimum": 1,
                        "maximum": 12
                      },
                      {
                        "type": "integer",
                        "metasysType": "byte",
                        "const": 255
                      },
                      {
                        "type": "string",
                        "metasysType": "string",
                        "const": "any"
                      },
                      {
                        "$ref": "https://desktop-vm/api/v6/schemas/enums/monthEnumSet"
                      }
                    ]
                  },
                  "dayOfMonth": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "metasysType": "byte",
                        "minimum": 1,
                        "maximum": 31
                      },
                      {
                        "type": "integer",
                        "metasysType": "byte",
                        "const": 255
                      },
                      {
                        "type": "string",
                        "metasysType": "string",
                        "const": "any"
                      },
                      {
                        "$ref": "https://desktop-vm/api/v6/schemas/enums/bacnetDayOfMonthEnumSet"
                      }
                    ]
                  },
                  "dayOfWeek": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "metasysType": "byte",
                        "minimum": 1,
                        "maximum": 7
                      },
                      {
                        "type": "integer",
                        "metasysType": "byte",
                        "const": 255
                      },
                      {
                        "type": "string",
                        "metasysType": "string",
                        "const": "any"
                      },
                      {
                        "$ref": "https://desktop-vm/api/v6/schemas/enums/dayOfWeekEnumSet"
                      }
                    ]
                  }
                },
                "required": [
                  "year",
                  "month",
                  "dayOfMonth"
                ],
                "display": [
                  "year",
                  "month",
                  "dayOfMonth"
                ],
                "additionalProperties": false
              }
            ],
            "title": "Date"
          },
          "time": {
            "oneOf": [
              {
                "allOf": [
                  {
                    "$ref": "#metasys-time"
                  },
                  {
                    "display": [
                      "hour",
                      "minute",
                      "second"
                    ]
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "metasysType": "time",
            "title": "Time"
          }
        },
        "default": {
          "date": null,
          "time": null
        }
      },
      "inputRef": {
        "title": "JCI Input Reference",
        "metasysType": "attributeReference",
        "oneOf": [
          {
            "$ref": "#attribute-reference"
          }
        ]
      },
      "bufferSize": {
        "title": "Buffer Size",
        "metasysType": "ulong",
        "type": "integer",
        "minimum": 1,
        "maximum": 5000,
        "default": 144
      },
      "stopWhenFull": {
        "title": "Stop When Full",
        "type": "boolean",
        "metasysType": "bool",
        "default": false
      },
      "sampleInterval": {
        "title": "Sample Interval",
        "metasysType": "ulong",
        "type": "integer",
        "minimum": 0,
        "maximum": 604800,
        "unit": {
          "id": "second",
          "title": "seconds"
        },
        "default": 600
      },
      "clientCovIncrement": {
        "title": "Client COV Increment",
        "metasysType": "float",
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "minimum": 0,
        "maximum": 3.40282347e+38
      },
      "repositoryEnabled": {
        "title": "Repository Enabled",
        "type": "boolean",
        "metasysType": "bool",
        "default": false
      },
      "transferSetpoint": {
        "title": "Transfer Setpoint",
        "metasysType": "ushort",
        "type": "integer",
        "minimum": 1,
        "maximum": 5000,
        "default": 130
      }
    },
    "definitions": {
      "metasys-date": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "#metasys-date",
        "title": "date",
        "description": "Metasys Date",
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "description": "Year"
          },
          "month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "description": "Month"
          },
          "dayOfMonth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31,
            "description": "Day of Month"
          },
          "dayOfWeek": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7,
            "description": "Day of Week"
          }
        },
        "additionalProperties": false
      },
      "metasys-time": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "#metasys-time",
        "title": "time",
        "description": "Metasys time",
        "type": "object",
        "properties": {
          "hour": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23,
            "description": "Hour"
          },
          "minute": {
            "type": "integer",
            "minimum": 0,
            "maximum": 59,
            "description": "Minute"
          },
          "second": {
            "type": "integer",
            "minimum": 0,
            "maximum": 59,
            "description": "Second"
          },
          "hundredth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99,
            "description": "Hundredths"
          }
        },
        "additionalProperties": false
      },
      "object-reference": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "#object-reference",
        "title": "Object reference data type",
        "type": "object",
        "oneOf": [
          {
            "properties": {
              "objectReference": {
                "format": "fully-qualified-reference",
                "type": "string"
              },
              "referencedObject": {
                "type": "object",
                "properties": {
                  "objectName": {
                    "type": "string"
                  },
                  "objectUrl": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "readOnly": true
              }
            },
            "required": [
              "objectReference"
            ]
          },
          {
            "properties": {
              "objectBACoid": {
                "readOnly": true,
                "oneOf": [
                  {
                    "$ref": "#bacoid"
                  }
                ]
              },
              "deviceAddress": {
                "readOnly": true,
                "type": "string"
              },
              "deviceBACoid": {
                "readOnly": true,
                "oneOf": [
                  {
                    "$ref": "#bacoid"
                  }
                ]
              }
            },
            "required": [
              "objectBACoid"
            ],
            "additionalProperties": false
          }
        ]
      },
      "attribute-reference": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "#attribute-reference",
        "title": "Attribute reference data type",
        "type": "object",
        "metasysType": "attributeReference",
        "allOf": [
          {
            "$ref": "#object-reference"
          },
          {
            "type": "object",
            "required": [
              "attribute"
            ],
            "properties": {
              "attribute": {
                "$ref": "https://desktop-vm/api/v6/schemas/enums/attributeEnumSet"
              },
              "referencedObject": {
                "readOnly": true,
                "type": "object",
                "properties": {
                  "attributeUrl": {
                    "type": "string",
                    "metasysType": "string",
                    "format": "uri"
                  },
                  "attributeName": {
                    "type": "string",
                    "metasysType": "string"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "required": [
      "name",
      "enable",
      "startTime",
      "stopTime",
      "inputRef",
      "bufferSize",
      "stopWhenFull",
      "sampleInterval",
      "repositoryEnabled",
      "transferSetpoint"
    ]
  },
  "views": [
    {
      "title": "Configuration",
      "views": [
        {
          "title": "Basic",
          "views": [
            {
              "title": "Reference",
              "properties": [
                "name",
                "description",
                "bacnetObjectType",
                "enable",
                "startTime",
                "stopTime",
                "inputRef"
              ],
              "id": "viewGroupEnumSet.referenceGrp"
            },
            {
              "title": "Local Storage",
              "properties": [
                "bufferSize",
                "stopWhenFull",
                "sampleInterval",
                "clientCovIncrement"
              ],
              "id": "viewGroupEnumSet.localStorageGrp"
            },
            {
              "title": "Repository Storage",
              "properties": [
                "repositoryEnabled",
                "transferSetpoint"
              ],
              "id": "viewGroupEnumSet.repositoryStorageGrp"
            }
          ],
          "id": "groupTypeEnumSet.basicGrpType"
        },
        {
          "title": "Advanced",
          "views": [],
          "id": "groupTypeEnumSet.advancedGrpType"
        }
      ],
      "id": "viewNameEnumSet.configView"
    }
  ]
}
