{
  "schema": {
    "type": "object",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "language": "en-US",
    "title": "BI Mapper",
    "version": "1.0",
    "$id": "https://desktop-vm/api/v6/schemas/objectTypes/biMapperClass",
    "properties": {
      "name": {
        "title": "Name",
        "category": "attributeCategoryEnumSet.nameCategory",
        "type": "string",
        "metasysType": "string",
        "maxLength": 400,
        "default": ""
      },
      "description": {
        "title": "Description",
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "metasysType": "string",
        "maxLength": 64
      },
      "bacnetObjectType": {
        "title": "Object Type",
        "readOnly": true,
        "allOf": [
          {
            "type": "string",
            "metasysType": "enum"
          },
          {
            "$ref": "https://desktop-vm/api/v6/schemas/enums/objectTypeEnumSet"
          }
        ],
        "default": "objectTypeEnumSet.bacBiClass"
      },
      "objectCategory": {
        "title": "Authorization Category",
        "category": "attributeCategoryEnumSet.objectCategoryCategory",
        "numberOfStates": 250,
        "allOf": [
          {
            "type": "string",
            "metasysType": "enum"
          },
          {
            "$ref": "https://desktop-vm/api/v6/schemas/enums/objectCategoryEnumSet?permission=modifyConfigItems"
          }
        ],
        "default": "objectCategoryEnumSet.generalCategory"
      },
      "instanceNumber": {
        "title": "Instance Number",
        "metasysType": "ulong",
        "type": "integer",
        "minimum": 0,
        "maximum": 4194303,
        "default": 0
      }
    },
    "required": [
      "name",
      "objectCategory",
      "instanceNumber"
    ]
  },
  "views": [
    {
      "title": "Configuration",
      "views": [
        {
          "title": "Basic",
          "views": [
            {
              "title": "Object",
              "properties": [
                "name",
                "description",
                "bacnetObjectType",
                "objectCategory"
              ],
              "id": "viewGroupEnumSet.objectGrp"
            }
          ],
          "id": "groupTypeEnumSet.basicGrpType"
        },
        {
          "title": "Advanced",
          "views": [],
          "id": "groupTypeEnumSet.advancedGrpType"
        }
      ],
      "id": "viewNameEnumSet.configView"
    },
    {
      "title": "Hardware",
      "views": [
        {
          "title": "Basic",
          "views": [
            {
              "title": "Setup",
              "properties": [
                "instanceNumber"
              ],
              "id": "viewGroupEnumSet.setupGrp"
            }
          ],
          "id": "groupTypeEnumSet.basicGrpType"
        },
        {
          "title": "Advanced",
          "views": [],
          "id": "groupTypeEnumSet.advancedGrpType"
        }
      ],
      "id": "viewNameEnumSet.hardwareView"
    }
  ]
}
