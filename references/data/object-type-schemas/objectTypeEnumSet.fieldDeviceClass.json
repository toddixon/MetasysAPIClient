{
  "schema": {
    "type": "object",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "language": "en-US",
    "title": "JCI Family BACnet Device",
    "version": "1.0",
    "$id": "https://desktop-vm/api/v6/schemas/objectTypes/fieldDeviceClass",
    "properties": {
      "name": {
        "title": "Name",
        "category": "attributeCategoryEnumSet.nameCategory",
        "type": "string",
        "metasysType": "string",
        "maxLength": 400,
        "default": ""
      },
      "description": {
        "title": "Description",
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "metasysType": "string",
        "maxLength": 64
      },
      "bacnetObjectType": {
        "title": "Object Type",
        "readOnly": true,
        "allOf": [
          {
            "type": "string",
            "metasysType": "enum"
          },
          {
            "$ref": "https://desktop-vm/api/v6/schemas/enums/objectTypeEnumSet"
          }
        ],
        "default": "objectTypeEnumSet.fieldDeviceClass"
      },
      "objectCategory": {
        "title": "Authorization Category",
        "category": "attributeCategoryEnumSet.objectCategoryCategory",
        "numberOfStates": 250,
        "allOf": [
          {
            "type": "string",
            "metasysType": "enum"
          },
          {
            "$ref": "https://desktop-vm/api/v6/schemas/enums/objectCategoryEnumSet?permission=modifyConfigItems"
          }
        ],
        "default": "objectCategoryEnumSet.generalCategory"
      },
      "enabled": {
        "title": "Enabled",
        "type": "boolean",
        "metasysType": "bool",
        "default": true
      },
      "vendorName": {
        "title": "Vendor Name",
        "readOnly": true,
        "type": "string",
        "metasysType": "string",
        "default": ""
      },
      "modelName": {
        "title": "Model Name",
        "readOnly": true,
        "type": "string",
        "metasysType": "string",
        "default": ""
      },
      "firmwareVersion": {
        "title": "Firmware Version",
        "readOnly": true,
        "type": "string",
        "metasysType": "string",
        "default": ""
      },
      "fixedBootVersion": {
        "title": "Fixed Boot Version",
        "readOnly": true,
        "type": "string",
        "metasysType": "string",
        "default": ""
      },
      "lastUploadDate": {
        "title": "Last Upload Date",
        "readOnly": true,
        "metasysType": "date",
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "metasysType": "date",
            "properties": {
              "year": {
                "oneOf": [
                  {
                    "type": "integer",
                    "metasysType": "ushort",
                    "minimum": 1900,
                    "maximum": 2154
                  },
                  {
                    "type": "integer",
                    "metasysType": "byte",
                    "minimum": 0,
                    "maximum": 254
                  }
                ]
              },
              "month": {
                "oneOf": [
                  {
                    "type": "integer",
                    "metasysType": "byte",
                    "minimum": 1,
                    "maximum": 12
                  },
                  {
                    "allOf": [
                      {
                        "type": "string",
                        "metasysType": "enum",
                        "lastMember": "monthEnumSet.monthDec"
                      },
                      {
                        "$ref": "https://desktop-vm/api/v6/schemas/enums/monthEnumSet"
                      }
                    ]
                  }
                ]
              },
              "dayOfMonth": {
                "oneOf": [
                  {
                    "type": "integer",
                    "metasysType": "byte",
                    "minimum": 1,
                    "maximum": 31
                  },
                  {
                    "allOf": [
                      {
                        "type": "string",
                        "metasysType": "enum",
                        "lastMember": "bacnetDayOfMonthEnumSet.bdom31"
                      },
                      {
                        "$ref": "https://desktop-vm/api/v6/schemas/enums/bacnetDayOfMonthEnumSet"
                      }
                    ]
                  }
                ]
              },
              "dayOfWeek": {
                "oneOf": [
                  {
                    "type": "integer",
                    "metasysType": "byte",
                    "minimum": 1,
                    "maximum": 7
                  },
                  {
                    "type": "integer",
                    "metasysType": "byte",
                    "const": 255
                  },
                  {
                    "type": "string",
                    "metasysType": "string",
                    "const": "any"
                  },
                  {
                    "$ref": "https://desktop-vm/api/v6/schemas/enums/dayOfWeekEnumSet"
                  }
                ]
              }
            },
            "required": [
              "year",
              "month",
              "dayOfMonth"
            ],
            "display": [
              "year",
              "month",
              "dayOfMonth"
            ],
            "additionalProperties": false
          }
        ]
      },
      "lastUploadTime": {
        "title": "Last Upload Time",
        "readOnly": true,
        "oneOf": [
          {
            "allOf": [
              {
                "$ref": "#metasys-time"
              },
              {
                "required": [
                  "hour",
                  "minute",
                  "second"
                ],
                "display": [
                  "hour",
                  "minute",
                  "second"
                ]
              }
            ]
          },
          {
            "type": "null"
          }
        ],
        "metasysType": "time"
      },
      "graphic": {
        "title": "Graphic",
        "oneOf": [
          {
            "type": "null"
          },
          {
            "$ref": "#object-reference"
          }
        ],
        "metasysType": "objectReference",
        "objectTypes": [
          "graphicClass",
          "xamlGraphicClass"
        ]
      },
      "graphicAlias": {
        "title": "Graphic Alias",
        "category": "attributeCategoryEnumSet.editableReferenceCategory",
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "metasysType": "string",
        "maxLength": 256
      },
      "instanceNumber": {
        "title": "Instance Number",
        "metasysType": "ulong",
        "type": "integer",
        "minimum": 0,
        "maximum": 4194303,
        "default": 0
      },
      "macAddress": {
        "title": "JCI MAC Address",
        "metasysType": "byte",
        "type": "integer",
        "default": 4,
        "minimum": 4,
        "maximum": 127
      },
      "disableAutoAlarm": {
        "title": "Disable Automatic Alarming",
        "type": "boolean",
        "metasysType": "bool",
        "default": false
      }
    },
    "definitions": {
      "metasys-date": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "#metasys-date",
        "title": "date",
        "description": "Metasys Date",
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "description": "Year"
          },
          "month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "description": "Month"
          },
          "dayOfMonth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31,
            "description": "Day of Month"
          },
          "dayOfWeek": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7,
            "description": "Day of Week"
          }
        },
        "additionalProperties": false
      },
      "metasys-time": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "#metasys-time",
        "title": "time",
        "description": "Metasys time",
        "type": "object",
        "properties": {
          "hour": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23,
            "description": "Hour"
          },
          "minute": {
            "type": "integer",
            "minimum": 0,
            "maximum": 59,
            "description": "Minute"
          },
          "second": {
            "type": "integer",
            "minimum": 0,
            "maximum": 59,
            "description": "Second"
          },
          "hundredth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99,
            "description": "Hundredths"
          }
        },
        "additionalProperties": false
      },
      "object-reference": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "#object-reference",
        "title": "Object reference data type",
        "type": "object",
        "oneOf": [
          {
            "properties": {
              "objectReference": {
                "format": "fully-qualified-reference",
                "type": "string"
              },
              "referencedObject": {
                "type": "object",
                "properties": {
                  "objectName": {
                    "type": "string"
                  },
                  "objectUrl": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "readOnly": true
              }
            },
            "required": [
              "objectReference"
            ]
          },
          {
            "properties": {
              "objectBACoid": {
                "readOnly": true,
                "oneOf": [
                  {
                    "$ref": "#bacoid"
                  }
                ]
              },
              "deviceAddress": {
                "readOnly": true,
                "type": "string"
              },
              "deviceBACoid": {
                "readOnly": true,
                "oneOf": [
                  {
                    "$ref": "#bacoid"
                  }
                ]
              }
            },
            "required": [
              "objectBACoid"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "required": [
      "name",
      "objectCategory",
      "enabled",
      "instanceNumber",
      "macAddress",
      "disableAutoAlarm"
    ]
  },
  "views": [
    {
      "title": "Configuration",
      "views": [
        {
          "title": "Basic",
          "views": [
            {
              "title": "Object",
              "properties": [
                "name",
                "description",
                "bacnetObjectType",
                "objectCategory",
                "enabled"
              ],
              "id": "viewGroupEnumSet.objectGrp"
            },
            {
              "title": "Device",
              "properties": [
                "vendorName",
                "modelName",
                "firmwareVersion",
                "fixedBootVersion",
                "lastUploadDate",
                "lastUploadTime"
              ],
              "id": "viewGroupEnumSet.deviceGrp"
            },
            {
              "title": "Graphic Association",
              "properties": [
                "graphic",
                "graphicAlias"
              ],
              "id": "viewGroupEnumSet.graphicGrp"
            }
          ],
          "id": "groupTypeEnumSet.basicGrpType"
        },
        {
          "title": "Advanced",
          "views": [],
          "id": "groupTypeEnumSet.advancedGrpType"
        }
      ],
      "id": "viewNameEnumSet.configView"
    },
    {
      "title": "Hardware",
      "views": [
        {
          "title": "Basic",
          "views": [
            {
              "title": "Network",
              "properties": [
                "instanceNumber",
                "macAddress",
                "disableAutoAlarm"
              ],
              "id": "viewGroupEnumSet.networkGrp"
            }
          ],
          "id": "groupTypeEnumSet.basicGrpType"
        },
        {
          "title": "Advanced",
          "views": [],
          "id": "groupTypeEnumSet.advancedGrpType"
        }
      ],
      "id": "viewNameEnumSet.hardwareView"
    }
  ]
}
